# ===== CARLITE - variables d'environnement (copier en .env et remplir) =====

# Base PostgreSQL (14+ recommandé, testé en 17)
DATABASE_URL="postgresql://carlite:<MOT_DE_PASSE>@localhost:5432/carlite?schema=public"

# Authentification (NextAuth)
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="<CHAINE_ALEATOIRE_LONGUE>"
# URL publique exacte du site, sans slash final
NEXTAUTH_URL="https://carlite.fr"

# Emails (formulaires devis / rappel / contact expert) - SMTP
SMTP_HOST="<ex: ssl0.ovh.net | smtp-relay.brevo.com | smtp.gmail.com>"
SMTP_PORT="587"
SMTP_SECURE="false"            # true si port 465
SMTP_USER="<utilisateur SMTP>"
SMTP_PASS="<mot de passe SMTP>"
EMAIL_FROM="CARLITE <noreply@carlite.fr>"
EMAIL_TO_LEADS="wd@carlite.fr"           # devis + demandes de rappel
EMAIL_TO_CONTACT="contact@carlite.fr"    # formulaire contact expert

# Stockage des photos uploadées depuis l'admin (compatible S3)
AWS_ACCESS_KEY_ID="<clé d'accès>"
AWS_SECRET_ACCESS_KEY="<clé secrète>"
AWS_REGION="eu-west-3"                  # 'auto' pour Cloudflare R2
AWS_BUCKET_NAME="carlite-medias"
AWS_FOLDER_PREFIX=""                    # ex: "carlite/" (avec slash final) ou vide
S3_ENDPOINT=""                          # vide pour AWS ; ex R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE="false"             # true pour MinIO
S3_PUBLIC_URL_BASE=""                   # URL publique du bucket (obligatoire hors AWS), ex: https://medias.carlite.fr
